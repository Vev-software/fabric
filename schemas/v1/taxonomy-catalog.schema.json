{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/taxonomy-catalog.schema.json",
  "title": "TaxonomyCatalogDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "capabilities", "reasons"],
  "properties": {
    "contractVersion": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["Feature", "Limit", "Resource", "Reason"]
          },
          "description": { "type": "string", "minLength": 1 },
          "reserved": { "type": "boolean" }
        }
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "deny": { "type": "boolean" }
        }
      }
    }
  }
}
