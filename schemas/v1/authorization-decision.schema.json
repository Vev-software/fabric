{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/authorization-decision.schema.json",
  "title": "AuthorizationDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["allowed", "action", "resource", "reasonCode", "source"],
  "properties": {
    "allowed": { "type": "boolean" },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
