{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/data-sharing-activation-record.schema.json",
  "title": "DataSharingActivationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enrollmentId",
    "codeHash",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "enrollmentId": {
      "type": "string",
      "minLength": 1
    },
    "codeHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "consumedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
