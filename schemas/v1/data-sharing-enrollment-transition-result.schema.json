{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/data-sharing-enrollment-transition-result.schema.json",
  "title": "DataSharingEnrollmentTransitionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted",
    "reasonCode",
    "enrollment"
  ],
  "properties": {
    "accepted": {
      "type": "boolean"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "enrollment": {
      "$ref": "data-sharing-enrollment-status.schema.json"
    },
    "activation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "data-sharing-activation-record.schema.json"
        }
      ]
    }
  }
}
