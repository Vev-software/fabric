{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/tenant-lifecycle-transition-request.schema.json",
  "title": "TenantLifecycleTransitionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant", "transition", "occurredAt", "timeline"],
  "properties": {
    "tenant": { "type": "string", "minLength": 1 },
    "transition": {
      "type": "string",
      "enum": ["EnterReadOnly", "Lock", "StartRetention", "PurgeData"]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "timeline": { "$ref": "tenant-lifecycle-timeline.schema.json" },
    "phaseUntil": { "type": ["string", "null"], "format": "date-time" }
  }
}
