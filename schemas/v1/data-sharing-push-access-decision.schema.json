{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/data-sharing-push-access-decision.schema.json",
  "title": "DataSharingPushAccessDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed",
    "enrollmentId",
    "capability",
    "reasonCode",
    "source",
    "evaluatedAt",
    "enrollmentState",
    "tenantLifecycleState"
  ],
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "enrollmentId": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "const": "atlas.landscape.share"
        }
      }
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "enrollmentState": {
      "type": "string",
      "enum": [
        "Pending",
        "Active",
        "Suspended",
        "Revoked",
        "Expired"
      ]
    },
    "tenantLifecycleState": {
      "type": "string",
      "enum": [
        "TrialActive",
        "TrialExpired",
        "ReadOnly",
        "Locked",
        "RetentionPeriod",
        "DataPurged"
      ]
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
