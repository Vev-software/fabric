{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/entitlement-request.schema.json",
  "title": "EntitlementRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant", "capability", "principal"],
  "properties": {
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "roles"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "displayName": { "type": ["string", "null"] },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "resource": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
