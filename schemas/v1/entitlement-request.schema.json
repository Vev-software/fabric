{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/entitlement-request.schema.json",
  "title": "EntitlementRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant", "capability", "principal"],
  "properties": {
    "tenant": { "$ref": "tenant-context.schema.json" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "principal": { "$ref": "principal-context.schema.json" },
    "resource": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
