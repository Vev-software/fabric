{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/data-sharing-enrollment-query.schema.json",
  "title": "DataSharingEnrollmentQuery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enrollmentId",
    "binding",
    "principal",
    "capability"
  ],
  "properties": {
    "enrollmentId": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "$ref": "data-sharing-binding.schema.json"
    },
    "principal": {
      "$ref": "principal-context.schema.json"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asOf": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
