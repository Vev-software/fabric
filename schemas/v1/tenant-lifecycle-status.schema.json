{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vev.software/fabric/v1/tenant-lifecycle-status.schema.json",
  "title": "TenantLifecycleStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant", "state", "reasonCode", "evaluatedAt", "timeline"],
  "properties": {
    "tenant": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["TrialActive", "TrialExpired", "ReadOnly", "Locked", "RetentionPeriod", "DataPurged"]
    },
    "reasonCode": { "type": "string", "minLength": 1 },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "timeline": { "$ref": "tenant-lifecycle-timeline.schema.json" }
  }
}
